#!/bin/bash
set -x
CONFIG_FILE=~/.config/hypr/conf.d/monitors.lua

exec > >(tee /tmp/output.log) 2>&1

HEIGHT=$1

if [[ $HEIGHT =~ reset ]]; then
  echo "Resetting monitor settings to maximum resolution with secondary screen..."
  DP1_MODE="5120x1440@239.76"
  DP3_DISABLE=false
elif [[ $HEIGHT -ge 1440 ]]; then
  echo "Setting single-monitor 1440p..."
  DP1_MODE="2560x1440@240"
  DP3_DISABLE=true
else
  echo "Setting single-monitor 1080p..."
  DP1_MODE="1920x1080@239.76"
  DP3_DISABLE=true
fi

HYPRLAND_INSTANCE_SIGNATURE=$(hyprctl instances -j | jq -r '.[].instance') hyprctl dispatch dpms on

if [ "$DP3_DISABLE" = true ]; then
  DP3_BLOCK='hl.monitor({
	output = "DP-3",
	disabled = true,
})'
else
  DP3_BLOCK='hl.monitor({
	output = "DP-3",
	mode = "1920x1080@60",
	position = "1750x1440",
	scale = 1,
})'
fi

cat <<EOF >"$CONFIG_FILE"
---@module 'hl'
-- Config file maintained by monitor-control script. Do not edit
hl.monitor({
	output = "DP-1",
	mode = "$DP1_MODE",
	position = "0x0",
	scale = "auto",
})

$DP3_BLOCK
EOF

sleep 2
