#!/bin/bash
set -x
CONFIG_FILE=~/.config/hypr/conf.d/monitors.lua

exec > >(tee /tmp/output.log) 2>&1

HEIGHT=$1

if [[ $HEIGHT =~ reset ]]; then
  echo "Resetting monitor settings to maximum resolution with secondary screen..."
  DP1=1920x1080@60,1750x1440,1
  DP3=5120x1440@239.76,0x0,auto
elif [[ $HEIGHT -ge 1440 ]]; then
  echo "Setting single-monitor 1440p..."
  DP1=disable
  DP3=2560x1440@240,0x0,auto
else
  echo "Setting single-monitor 1080p..."
  DP1=disable
  DP3=1920x1080@239.76,0x0,auto
fi

format_monitor() {
  local output="$1"
  local spec="$2"
  if [[ "$spec" == "disable" ]]; then
    cat <<EOF
hl.monitor({
	output = "$output",
	disabled = true,
})
EOF
  else
    IFS=',' read -r mode pos scale <<< "$spec"
    local scale_val
    if [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      scale_val="$scale"
    else
      scale_val="\"$scale\""
    fi
    cat <<EOF
hl.monitor({
	output = "$output",
	mode = "$mode",
	position = "$pos",
	scale = $scale_val,
})
EOF
  fi
}

HYPRLAND_INSTANCE_SIGNATURE=$(hyprctl instances -j | jq -r '.[].instance') hyprctl dispatch dpms on

{
  echo "---@module 'hl'"
  echo ""
  echo "-- Config file maintained by monitor-control script. Do not edit"
  echo ""
  format_monitor "DP-3" "$DP3"
  echo ""
  format_monitor "DP-1" "$DP1"
} > "$CONFIG_FILE"

sleep 2
