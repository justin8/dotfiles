# https://github.com/Homebrew/homebrew-bundle
# specify a directory to install
cask_args appdir: '/Applications'

# Enable app store installations
brew "mas"
tap "abue-ammar/tinycast"

# Casks
cask "bitwarden"
cask "easy-move+resize"
cask "firefox"
cask "google-drive"
cask "iterm2"
cask "obsidian"
cask "omnifocus"
cask "rectangle"
cask "sublime-text"
cask "syncthing-app"
cask "tinycast"
cask "visual-studio-code"
cask "zen"

# General packages
brew "awscurl"
brew "awscli"
brew "bash"
brew "zsh"
brew "zsh-completions"
